# 墨戏生花 环境变量配置

# ═══════════════════════════════════════════════════════════
# 自学习/自我进化配置
# ═══════════════════════════════════════════════════════════

# 透明模式阈值：前 N 个段落不做干预，只观察
LEARNING_TRANSPARENT_THRESHOLD=3

# 轻量模式阈值：N 个段落后开始追加参考数据
LEARNING_LIGHTWEIGHT_THRESHOLD=10

# 高质量素材阈值
LEARNING_QUALITY_THRESHOLD_HIGH=0.8
LEARNING_QUALITY_THRESHOLD_MEDIUM=0.6

# 智能模式触发：用户输入长度小于此值时自动补全
LEARNING_SMART_INPUT_THRESHOLD=50

# ═══════════════════════════════════════════════════════════
# OpenSpace MCP 配置（如果部署了 OpenSpace）
# ═══════════════════════════════════════════════════════════

# OpenSpace 工作空间路径
OPENSPACE_WORKSPACE=/tmp/OpenSpace

# Host Skills 目录
OPENSPACE_HOST_SKILL_DIRS=~/.claude/skills/using-openspace/host_skills

# OpenSpace LLM 配置（用于技能进化）
OPENSPACE_LLM_API_KEY=your-api-key
OPENSPACE_LLM_BASE_URL=https://api.moonshot.cn/anthropic
OPENSPACE_LLM_MODEL=claude-sonnet-4-6

# ═══════════════════════════════════════════════════════════
# 数据库配置
# ═══════════════════════════════════════════════════════════

# SQLite 数据库路径（默认使用 SQLite）
DATABASE_URL=sqlite:///./moxishenghua.db

# 如果需要使用 PostgreSQL，取消下面注释
# DATABASE_URL=postgresql://user:password@localhost:5432/moxishenghua

# ═══════════════════════════════════════════════════════════
# 可选 Redis 缓存（未配置或不可用时自动降级为进程内 TTL 缓存）
# ═══════════════════════════════════════════════════════════

# MOXI_REDIS_URL=redis://127.0.0.1:6379/0
MOXI_DASHBOARD_CACHE_TTL=15

# ═══════════════════════════════════════════════════════════
# API 配置
# ═══════════════════════════════════════════════════════════

# 服务监听配置
SERVER_HOST=0.0.0.0
SERVER_PORT=6565

# 调试模式
DEBUG=false

# ═══════════════════════════════════════════════════════════
# 安全配置
# ═══════════════════════════════════════════════════════════

# 管理员 Token（用于 Agent 注册等敏感操作）
ADMIN_TOKEN=your-secure-admin-token

# Agent 注册令牌
REGISTRATION_TOKEN=your-registration-token

# 是否允许 Agent 自注册
ALLOW_REGISTRATION=true
